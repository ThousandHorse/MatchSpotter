rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザーコレクション
    // 認証済みユーザーは全ユーザーの情報を読み取り可能
    // 書き込みは自分のドキュメントのみ
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // 共有写真コレクション
    // 認証済みユーザーは全ての写真を読み取り可能
    // 作成は認証済みユーザーのみ、かつuserIdが自分のIDと一致する場合のみ
    // 更新は全ての認証済みユーザーが可能（いいね機能のため）
    // 削除は自分が投稿した写真のみ
    match /sharedPhotos/{photoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // 招待コードコレクション
    // 認証済みユーザーは読み取り可能
    // 書き込みは管理者のみ（Admin SDK経由で管理）
    match /inviteCodes/{codeId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDKからのみ操作可能
    }

    // エリアサマリーコレクション（最適化用）
    // 認証済みユーザーは全て読み取り可能
    // 書き込みはCloud Functionsからのみ
    match /prefecturesSummary/{prefectureName} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functionsからのみ更新可能
    }
  }
}
